ENVIRONMENT=production
MUTATIONS_ENABLED=true
# Configure the same strong random value as a secret on the API and dashboard services.
API_WRITE_KEY=CHANGE_ME
STORAGE_BACKEND=oci
STORAGE_BUCKET=CommunityLab-Bucket
OCI_NAMESPACE=CHANGE_ME
OCI_REGION=sa-santiago-1
OCI_USE_INSTANCE_PRINCIPAL=false
OCI_CONFIG_FILE=/etc/secrets/oci_config
