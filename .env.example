# Copy to .env. Development-only values; no production secrets.
APP_NAME=CommunityLab API
API_SCHEMA_VERSION=v1
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://communitylab:communitylab@db:5432/communitylab
API_URL=http://api:8000
# Local development permits mutations. In shared environments, either disable
# them or configure the same secret in the API and dashboard services.
MUTATIONS_ENABLED=true
# API_WRITE_KEY=generate-a-long-random-secret
MUTATION_RATE_LIMIT=60
MUTATION_RATE_WINDOW_SECONDS=60
POSTGRES_DB=communitylab
POSTGRES_USER=communitylab
POSTGRES_PASSWORD=communitylab
STORAGE_BACKEND=local
STORAGE_BUCKET=communitylab-local
LOCAL_STORAGE_PATH=/tmp/communitylab-storage
# Gemini analyzes interactions and generates LinkedIn drafts plus proposed FAQs. Keep the
# API key in this ignored local .env file or the deployment's secret settings.
ANALYSIS_PROVIDER=gemini
# ANALYSIS_FALLBACK_PROVIDER=mock
ANALYSIS_MAX_ATTEMPTS=2
ANALYSIS_PROMPT_VERSION=analysis-gemini-v1
FAQ_RECURRENCE_THRESHOLD=2
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# OCI_NAMESPACE=
# OCI_REGION=sa-saopaulo-1
# OCI_USE_INSTANCE_PRINCIPAL=true
# For API-key authentication, optionally point to an OCI config file.
# OCI_CONFIG_FILE=
